{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "schedules": {
    "revision-diaria": {
      "schedule": "0 7 * * *",
      "path": "/api/cron/diario",
      "requestMethod": "GET"
    },
    "respaldo-semanal": {
      "schedule": "0 6 * * 1",
      "path": "/api/cron/semanal",
      "requestMethod": "GET"
    },
    "vigilancia-dependencias": {
      "schedule": "*/15 * * * *",
      "path": "/api/cron/dependencias",
      "requestMethod": "GET"
    }
  }
}
