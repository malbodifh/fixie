# Clave maestra: cifra tokens y conexiones y firma la sesión. Genera 32 bytes aleatorios.
AUTOSANA_SECRET=
# Protege /api/cron/semanal (Vercel Cron la envía como Bearer).
CRON_SECRET=
# URL pública de Autosana (callback de OAuth y variables que se muestran al instalar).
AUTOSANA_BASE_URL=http://localhost:3000

# Base de datos propia de Autosana (Supabase). Solo el servidor la usa.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# OAuth App de GitHub. Callback: <AUTOSANA_BASE_URL>/api/auth/callback. Scope: repo read:user.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Solo desarrollo: entrar sin OAuth App con un token propio (p. ej. `gh auth token`).
DEV_GITHUB_TOKEN=

# Modelo de los agentes: ANTHROPIC_API_KEY o, como alternativa, AI_GATEWAY_API_KEY.
ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=
# AGENT_MODEL=claude-sonnet-5-5

# Lighthouse (PageSpeed Insights). Gratis: console.cloud.google.com → habilitar "PageSpeed Insights API" → Credenciales → Clave de API.
PSI_API_KEY=
